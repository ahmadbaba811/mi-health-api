# Copy this file to .env and fill with your values
# For local SQL Server (default instance), set DB_ENCRYPT=false

# Database connection
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=a
DB_DATABASE=MiHealthDb

# For local/dev SQL Server using self-signed certs or no encryption
# set DB_ENCRYPT=false or DB_TRUST_SERVER_CERT=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# API server port
PORT=3000

# SMTP email configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-gmail@gmail.com
